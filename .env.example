# ============================================================
# FightVision AI — environment variables
# Скопируй в .env и подставь свои значения.
# ============================================================

# Redis (общая очередь + хранилище job state)
# При docker-compose host=redis, при локальном запуске host=localhost
FV_REDIS_URL=redis://localhost:6379/0

# Где хранить загруженные видео и результаты
FV_MEDIA_DIR=./media

# Лимит на размер видео в МБ
FV_MAX_UPLOAD_MB=500

# CORS — фронт разрешён по умолчанию из dev сервера vite
FV_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Сколько хранить job state в Redis (секунды). По умолчанию сутки.
FV_JOB_TTL_SECONDS=86400

# ============================================================
# ML worker
# ============================================================

# Куда worker'у ходить за моделями. Обычно ./models внутри ml_worker
FV_MODELS_DIR=./models

# YOLO-pose модель. Чем больше — тем точнее и медленнее.
# Варианты: yolov8n-pose.pt (быстро), yolov8m-pose.pt (баланс), yolov8l-pose.pt (медленно/точно)
FV_YOLO_POSE_MODEL=yolov8n-pose.pt
FV_YOLO_CONF=0.25
FV_YOLO_IOU=0.50

# Имя очереди RQ. Менять не нужно если ничего параллельно не крутишь.
FV_QUEUE_NAME=fightvision

# Padding в секундах вокруг каждого удара при нарезке хайлайтов
FV_HIGHLIGHT_PAD_BEFORE=0.6
FV_HIGHLIGHT_PAD_AFTER=0.6

# ============================================================
# Telegram bot
# ============================================================

# Токен из @BotFather. Без него бот не стартанёт.
TELEGRAM_BOT_TOKEN=

# URL gateway'а с точки зрения бота
# Локально: http://localhost:8000
# В docker-compose: http://backend:8000
FV_BACKEND_URL=http://localhost:8000

# Сколько ждать максимум один job (секунды) перед тем как сдаться
FV_BOT_POLL_TIMEOUT=900

# Интервал поллинга статуса (секунды)
FV_BOT_POLL_INTERVAL=4
